# Google Gemini API Configuration (for Gemini Flash Lite Multimodal Judge)
GEMINI_API_KEY=your_gemini_api_key_here
JUDGE_MODEL=gemini-3.5-flash-lite

# OpenRouter API Configuration (Alternative for Gemini / any model)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Groq API Configuration (Generator)
# Single key:
GROQ_API_KEY=gsk_your_groq_key_here
# Multiple keys for OTPM rotation (comma-separated or enumerated):
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# GROQ_API_KEY_1=gsk_key1
# GROQ_API_KEY_2=gsk_key2
GROQ_MODEL=qwen/qwen3.8-27b

PORT=8000
